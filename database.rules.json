{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      ".read": true
    },
    "presence": {
      "$gameId": {
        ".read": true,
        "$playerId": {
          "$connectionId": {
            ".write": "auth != null && (root.child('gameRecords').child($gameId).child('authorizations').child($playerId).val() === auth.uid || (!root.child('gameRecords').child($gameId).exists() && root.child('gameAuthorizations').child($gameId).child($playerId).val() === auth.uid))"
          }
        }
      }
    },
    "gameAuthorizations": {
      ".read": false,
      ".write": false
    },
    "gameRecords": {
      ".read": false,
      ".write": false
    },
    "joinCodes": {
      ".read": false,
      ".write": false
    },
    "createGameRequests": {
      ".read": false,
      ".write": false
    },
    "users": {
      ".read": false,
      ".write": false
    }
  }
}
