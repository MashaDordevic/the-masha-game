{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/addGame", "function": "addGame" },
      { "source": "/joinGame", "function": "joinGame" },
      { "source": "/findGame", "function": "findGame" },
      { "source": "/startGame", "function": "startGame" },
      { "source": "/kickPlayer", "function": "kickPlayer" },
      { "source": "/addWord", "function": "addWord" },
      { "source": "/deleteWord", "function": "deleteWord" },
      { "source": "/enterBetweenRounds", "function": "enterBetweenRounds" },
      { "source": "/advanceRound", "function": "advanceRound" },
      { "source": "/startTurn", "function": "startTurn" },
      { "source": "/pauseTurn", "function": "pauseTurn" },
      { "source": "/guessWord", "function": "guessWord" },
      { "source": "/expireTurn", "function": "expireTurn" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
